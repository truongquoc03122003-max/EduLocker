# Cấu hình Supabase cho EduLocker (Phase 2+)
# Ưu tiên biến chuẩn hiện hành của Supabase SSR:
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Hỗ trợ tương thích ngược nếu dự án Supabase vẫn dùng tên biến cũ:
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chỉ sử dụng phía Server / Script quản trị cục bộ (TUYỆT ĐỐI KHÔNG đưa ra Client):
SUPABASE_SERVICE_ROLE_KEY=

# Cấu hình môi trường ứng dụng
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_UNIVERSITY=CTU

# Chế độ trình diễn (Demo Mode) – CHỈ DÙNG PHÍA SERVER (không prefix NEXT_PUBLIC_)
# Mặc định TẮT (false) trong production nếu không cấu hình.
EDULOCKER_DEMO_MODE=true
